proc STG_bielliptic_d10_pi6(list #) "USAGE: STG_bielliptic_d10_pi6([lambda,mu]); RETURN: generic bielliptic quotient-cover data. MATHEMATICS: finite free quotient of product of elliptic curves. EXAMPLE: ring r=31991,(dummy),dp; list S=STG_bielliptic_d10_pi6();" { return(STG_bielliptic_cover_data(#)); }
