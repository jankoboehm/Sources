///////////////////////////////////////////////////////////////////////////////
version="version surface_type_generics.lib 0.1.0 Jul_2026";
category="Algebraic Geometry";
info="
LIBRARY:  surface_type_generics.lib
AUTHOR:   GPT-5.5 Pro, generated for stand-alone generic surface constructions.

PURPOSE:
  Build generic representatives of the surface types appearing in a fixed
  catalogue of smooth algebraic surfaces: rational, ruled over an elliptic
  curve, K3 type, Enriques type, abelian type, bielliptic / hyperelliptic
  type, and properly elliptic type.

  This file deliberately does not deform hard-coded ideals.  Each constructor
  starts from a geometric parameter space: determinantal scrolls, projected
  Veronese maps, complete intersections, Segre products of curves, or finite
  quotient data.  The returned surface is therefore a generic member of the
  chosen construction family, not a coordinate change of a stored example.

WHAT \"GENERIC\" MEANS HERE:
  The procedures choose random coefficients in an explicitly described family.
  Smoothness and the asserted surface type hold on a non-empty Zariski open
  subset of the parameter space.  A random specialization over a sufficiently
  large field is expected to land in this open subset.  For serious use, run a
  smoothness check afterwards, or use the classification library on the output.

  For old degree/sectional-genus labels, STG_catalogueType records the
  birational/Kodaira type.  Call one of the direct constructors below for a
  generic representative of that type.  Exact embedded parameter spaces for the
  high-degree P^4 models are much more specialized and are usually built by
  liaison or syzygy constructions.

CHARACTERISTIC WARNINGS:
  * Enriques quotients by an involution are implemented for characteristic not 2.
  * The Hesse order-3 bielliptic construction is for characteristic not 3 and,
    for an explicit quotient by invariant sections, over a field containing a
    primitive cube root of unity.  The default routine returns the cover and the
    group action as quotient data.
  * Product, scroll and complete-intersection constructors are characteristic
    independent apart from the usual smoothness discriminants.

REFERENCES, NOT DEPENDENCIES:
  - W. Decker, L. Ein, F.-O. Schreyer, Construction of surfaces in P^4,
    J. Algebraic Geometry 2 (1993), 185-237.
  - S. Popescu, Examples of smooth non-general type surfaces in P^4,
    Proc. London Math. Soc. 76 (1998), 257-275.
  - W. Decker, F.-O. Schreyer, Non-general type surfaces in P^4: some remarks
    on bounds and constructions, J. Symbolic Computation 29 (2000), 545-582.
  - W. Barth, K. Hulek, C. Peters, A. Van de Ven, Compact Complex Surfaces,
    2nd enlarged ed., Springer, 2004.
  - F. Cossec, I. Dolgachev, Enriques Surfaces I, Birkhaeuser, 1989.
  - R. Miranda, Persson-type constructions and the standard quotient picture
    for bielliptic surfaces; equivalently, every bielliptic surface is a finite
    free quotient of a product of elliptic curves.
  - M. Artebani, I. Dolgachev, The Hesse pencil of plane cubic curves,
    Enseign. Math. 55 (2009), 235-273.

RETURN CONVENTION:
  Most constructors return a list [R, I, type, description].  The ideal I lives
  in the returned ring R.  Use setring on the first entry before working with I.

EXAMPLE:
  LIB \"surface_type_generics.lib\";
  ring r=31991,(dummy),dp;
  list K=STG_K3();
  setring K[1];
  ideal IK3=K[2];
  IK3;
";

LIB "matrix.lib";
LIB "elim.lib";

///////////////////////////////////////////////////////////////////////////////
// Internal utility functions
///////////////////////////////////////////////////////////////////////////////

static proc STG_default_bound(list #)
"USAGE:   STG_default_bound([bound]);
RETURN:  an integer coefficient bound.
PURPOSE: Internal helper.  All random constructors use a small integer bound by
         default.  Over a finite field, the integers are interpreted in the
         coefficient field.  Over characteristic zero, they are rational integers.
EXAMPLE: ring r=0,(x),dp; STG_default_bound();
"
{
  int bound=20;
  if(size(#)>0) { bound=#[1]; }
  if(bound<1) { bound=20; }
  return(bound);
}

static proc STG_coeff(int bound)
"USAGE:   STG_coeff(bound);
RETURN:  a non-zero random scalar represented by an integer.
PURPOSE: Internal helper for random forms.  Avoiding zero coefficients reduces
         the chance of accidentally leaving the intended open subset.
EXAMPLE: ring r=31991,(x),dp; STG_coeff(10);
"
{
  int c=random(-bound,bound);
  if(c==0) { c=1; }
  return(c);
}

static proc STG_unique_suffix()
"USAGE:   STG_unique_suffix();
RETURN:  a short suffix for dynamically created ring names.
PURPOSE: Internal helper.  Constructors may be called several times in the same
         second, so timer alone is not enough to avoid redefinition warnings.
EXAMPLE: ring r=0,(x),dp; STG_unique_suffix();
"
{
  return("_"+string(timer)+"_"+string(random(1,1000000000)));
}

static proc STG_random_homogeneous(int d, int bound)
"USAGE:   STG_random_homogeneous(d,bound); d>=0
RETURN:  a random homogeneous polynomial of degree d in all variables of the
         current ring.
MATHEMATICS:
         Smooth complete intersections and 1-generic determinantal models are
         open conditions on coefficients.  This helper samples the coefficient
         space of forms of a fixed degree.
EXAMPLE: ring r=31991,(x0,x1,x2,x3,x4),dp; STG_random_homogeneous(2,10);
"
{
  ideal mons=maxideal(d);
  poly f=0;
  int i;
  for(i=1;i<=size(mons);i=i+1)
  {
    f=f+STG_coeff(bound)*mons[i];
  }
  if(f==0) { f=mons[1]; }
  return(f);
}

static proc STG_form3(poly A, poly B, poly C, int d, int bound)
"USAGE:   STG_form3(A,B,C,d,bound);
RETURN:  a random homogeneous expression of degree d in A,B,C.
MATHEMATICS:
         Used for curves pulled back from the two factors of a Segre product.
         For example, f(column_j)=0 for every column cuts E x P^1 or E x F on
         a rank-one matrix parameterizing P^2 x P^1 or P^2 x P^2.
EXAMPLE: ring r=31991,(a,b,c),dp; STG_form3(a,b,c,3,10);
"
{
  int i;
  int j;
  int k;
  poly f=0;
  for(i=0;i<=d;i=i+1)
  {
    for(j=0;j<=d-i;j=j+1)
    {
      k=d-i-j;
      f=f+STG_coeff(bound)*A^i*B^j*C^k;
    }
  }
  return(f);
}

static proc STG_hesse(poly A, poly B, poly C, number lam)
"USAGE:   STG_hesse(A,B,C,lambda);
RETURN:  A^3+B^3+C^3-3*lambda*A*B*C.
MATHEMATICS:
         This is the Hesse pencil of plane cubic curves.  Away from the
         discriminant lambda^3=1, and in characteristic not 3 in this simple
         presentation, it gives a smooth elliptic curve.  The Hesse pencil is
         convenient because some torsion translations are linear projective
         transformations.
EXAMPLE: ring r=31991,(x,y,z),dp; STG_hesse(x,y,z,2);
"
{
  poly f=A^3+B^3+C^3-3*lam*A*B*C;
  return(f);
}

static proc STG_quartic3(poly A, poly B, poly C, int bound)
"USAGE:   STG_quartic3(A,B,C,bound);
RETURN:  a random plane quartic expression in A,B,C.
MATHEMATICS:
         A smooth plane quartic has genus 3.  The product of such a curve with
         an elliptic curve is a smooth elliptic surface of Kodaira dimension 1.
         Smoothness is open in the quartic coefficient space.
EXAMPLE: ring r=31991,(x,y,z),dp; STG_quartic3(x,y,z,10);
"
{
  return(STG_form3(A,B,C,4,bound));
}


static proc STG_quartic3_special(poly A, poly B, poly C, number a, number b, number c, number d)
"USAGE:   STG_quartic3_special(A,B,C,a,b,c,d);
RETURN:  a four-parameter plane quartic in A,B,C.
MATHEMATICS:
         The same coefficients can be reused on all rows of a Segre matrix, so
         the equations really cut one plane quartic factor rather than three
         unrelated quartics.  Smoothness holds away from the discriminant.
EXAMPLE: ring r=31991,(x,y,z),dp; STG_quartic3_special(x,y,z,1,2,3,4);
"
{
  poly f=A^4+B^4+C^4+a*A^2*B^2+b*A^2*C^2+c*B^2*C^2+d*A*B*C*(A+B+C);
  return(f);
}

static proc STG_product_eliminate_vars(int n)
"USAGE:   STG_product_eliminate_vars(n);
RETURN:  product var(1)*...*var(n) in the current ring.
PURPOSE: Internal helper for eliminate(..., product).  In the image-kernel
         computations, the first n variables are source variables to eliminate.
EXAMPLE: ring r=0,(a,b,c,x,y),dp; STG_product_eliminate_vars(3);
"
{
  int i;
  poly p=1;
  for(i=1;i<=n;i=i+1)
  {
    p=p*var(i);
  }
  return(p);
}

static proc STG_image_of_forms_mod_ideal(ideal Base, ideal Forms, string prefix)
"USAGE:   STG_image_of_forms_mod_ideal(Base,Forms,prefix);
RETURN:  list [Rbig, J, FormsBig, description].  J is the kernel of the map
         k[prefix_i] -> k[source]/Base, prefix_i |-> Forms[i], represented in
         a ring containing both source and target variables.
MATHEMATICS:
         If Forms are homogeneous of the same degree and have no common base
         point on the relevant source after resolving the stated construction,
         Proj(k[Forms]) is the projective image.  For quotient constructions,
         Forms are invariant sections and Proj(k[Forms]) is a projective model
         of the quotient by the finite group action.
EXAMPLE: ring r=0,(s,t,u),dp; ideal B=0; ideal F=s2,t2,u2,s*t,s*u;
         list L=STG_image_of_forms_mod_ideal(B,F,\"y\");
"
{
  def oldring=basering;
  ideal Bold=Base;
  ideal Fold=Forms;
  int n0=nvars(oldring);
  int m=size(Forms);
  string vars=varstr(oldring)+","+prefix+"(1.."+string(m)+")";
  string ringOrder="(dp("+string(n0)+"),dp("+string(m)+"))";
  string rname="STG_image"+STG_unique_suffix()+"_"+string(m);
  execute("ring "+rname+"="+charstr(oldring)+",("+vars+"),"+ringOrder+";");
  execute("def STG_CREATED_RING="+rname+";");
  def Rbig=STG_CREATED_RING;
  kill STG_CREATED_RING;
  setring Rbig;
  ideal B=imap(oldring,Bold);
  ideal F=imap(oldring,Fold);
  ideal E=B;
  int i;
  for(i=1;i<=m;i=i+1)
  {
    E[size(E)+1]=var(n0+i)-F[i];
  }
  poly src=STG_product_eliminate_vars(n0);
  ideal J=eliminate(E,src);
  list Out=Rbig,J,F,"image ideal by elimination; target variables are the last variables";
  execute("keepring "+rname+";");
  return(Out);
}

static proc STG_segre_2x2_minors(matrix Z)
"USAGE:   STG_segre_2x2_minors(Z); Z a matrix of variables
RETURN:  ideal of all 2x2 minors of Z.
MATHEMATICS:
         The 2x2 minors of a matrix of homogeneous coordinates cut out the
         Segre variety of rank-one matrices, such as P^2 x P^1 or P^2 x P^2.
EXAMPLE: ring r=0,(a,b,c,d,e,f),dp; matrix Z[3][2]=a,b,c,d,e,f;
         STG_segre_2x2_minors(Z);
"
{
  return(minor(Z,2));
}

static proc STG_same_type_note(string requested, string returned)
"USAGE:   STG_same_type_note(requested,returned);
RETURN:  explanatory string for catalogue wrappers.
PURPOSE: Internal helper.  Some catalogue labels include embedded invariants;
         the wrappers in this library preserve the surface type, not necessarily
         the special P^4 Hilbert polynomial.
EXAMPLE: ring r=0,(x),dp; STG_same_type_note(\"k3_d7_pi5\",\"K3\");
"
{
  string s="requested label: "+requested+"; returned a generic "+returned;
  s=s+" construction of the same Kodaira/minimal type; embedded degree and";
  s=s+" sectional genus are preserved only by the named direct constructors.";
  return(s);
}

///////////////////////////////////////////////////////////////////////////////
// Direct generic surface-type constructors
///////////////////////////////////////////////////////////////////////////////

proc STGinfo()
"USAGE:   STGinfo();
RETURN:  a short string describing the library.
MATHEMATICS:
         The library constructs generic representatives by geometric recipes:
         determinantal scrolls for rational ruled surfaces, complete
         intersections for K3 surfaces, products of curves for abelian/elliptic
         surfaces, and free quotient data for Enriques and bielliptic surfaces.
EXAMPLE: STGinfo();
"
{
  string s="surface_type_generics.lib: stand-alone generic constructions for ";
  s=s+"rational, elliptic ruled, K3, Enriques, abelian, bielliptic, and ";
  s=s+"properly elliptic surface types.  Constructors return [ring,ideal,type,notes], ";
  s=s+"or quotient-cover data for finite quotient types.";
  return(s);
}

proc STGsurfaceTypes()
"USAGE:   STGsurfaceTypes();
RETURN:  list of supported type names.
MATHEMATICS:
         These names correspond to the surface types in the Enriques-Kodaira
         classification which occur in the catalogue for non-general-type
         surfaces: rational/ruled, Kodaira dimension 0 types, and properly
         elliptic types.
EXAMPLE: list T=STGsurfaceTypes(); T;
"
{
  list T="rational","rational_scroll","projected_veronese","elliptic_ruled","K3","Enriques","abelian","bielliptic","elliptic";
  return(T);
}

proc STG_cubic_scroll(list #)
"USAGE:   STG_cubic_scroll([bound]);
RETURN:  list [R,I,\"rational\",description], where I is generated by the 2x2
         minors of a generic 2x3 matrix of linear forms in P^4.
MATHEMATICS:
         A 1-generic 2x3 matrix of linear forms on P^4 has rank-one locus a
         smooth cubic rational normal scroll.  The 1-generic condition is open;
         random coefficients give a generic member of this determinantal family.
EXAMPLE: ring r=31991,(dummy),dp; list S=STG_cubic_scroll(); setring S[1]; S[2];
"
{
  int bound=STG_default_bound(#);
  def oldring=basering;
  string rname="STG_cubic_scroll_R"+STG_unique_suffix();
  execute("ring "+rname+"="+charstr(oldring)+",(x0,x1,x2,x3,x4),dp;");
  execute("def STG_CREATED_RING="+rname+";");
  def R=STG_CREATED_RING;
  kill STG_CREATED_RING;
  setring R;
  matrix M[2][3];
  int i;
  int j;
  for(i=1;i<=2;i=i+1)
  {
    for(j=1;j<=3;j=j+1)
    {
      M[i,j]=STG_random_homogeneous(1,bound);
    }
  }
  ideal I=minor(M,2);
  list Out=R,I,"rational","generic cubic rational normal scroll in P^4 from 2x2 minors of a 1-generic 2x3 linear matrix";
  execute("keepring "+rname+";");
  return(Out);
}

proc STG_projected_veronese(list #)
"USAGE:   STG_projected_veronese([bound]);
RETURN:  list [Rbig,J,\"rational\",description].  J is an elimination ideal for
         the image of P^2 by five random conics.
MATHEMATICS:
         The complete conic system embeds P^2 as the Veronese surface in P^5.
         A general five-dimensional subsystem is projection from a point outside
         the secant hypersurface, hence gives a smooth projected Veronese surface
         in P^4.  Smoothness is an open condition on the chosen subsystem.
EXAMPLE: ring r=31991,(dummy),dp; list V=STG_projected_veronese(); setring V[1]; V[2];
"
{
  int bound=STG_default_bound(#);
  def oldring=basering;
  string rname="STG_projected_veronese_R"+STG_unique_suffix();
  execute("ring "+rname+"="+charstr(oldring)+",(s,t,u,y1,y2,y3,y4,y5),(dp(3),dp(5));");
  execute("def STG_CREATED_RING="+rname+";");
  def Rbig=STG_CREATED_RING;
  kill STG_CREATED_RING;
  setring Rbig;
  ideal F;
  F[1]=s^2+STG_coeff(bound)*t*u;
  F[2]=t^2+STG_coeff(bound)*s*u;
  F[3]=u^2+STG_coeff(bound)*s*t;
  F[4]=s*t+STG_coeff(bound)*s*u;
  F[5]=t*u+STG_coeff(bound)*s*u+STG_coeff(bound)*s*t;
  ideal E;
  int i;
  for(i=1;i<=5;i=i+1)
  {
    E[i]=var(3+i)-F[i];
  }
  poly src=s*t*u;
  ideal J=eliminate(E,src);
  string tname="STG_projected_veronese_target_R"+STG_unique_suffix();
  execute("ring "+tname+"="+charstr(oldring)+",(y1,y2,y3,y4,y5),dp;");
  execute("def STG_CREATED_RING="+tname+";");
  def Rt=STG_CREATED_RING;
  kill STG_CREATED_RING;
  setring Rt;
  ideal Jt=imap(Rbig,J);
  list Out=Rt,Jt,"rational","generic projected Veronese surface: image of P^2 by a general 5-dimensional subsystem of conics";
  execute("keepring "+tname+";");
  return(Out);
}

proc STG_K3(list #)
"USAGE:   STG_K3([bound]);
RETURN:  list [R,I,\"K3\",description], where I=(quadric,cubic) in P^4.
MATHEMATICS:
         A smooth complete intersection of type (2,3) in P^4 has trivial
         canonical bundle by adjunction, H^1(O)=0 by the Lefschetz/complete
         intersection cohomology calculation, and is a K3 surface.  Smoothness
         is open in the space of pairs (Q,C).
EXAMPLE: ring r=31991,(dummy),dp; list K=STG_K3(); setring K[1]; K[2];
"
{
  int bound=STG_default_bound(#);
  def oldring=basering;
  string rname="STG_K3_R"+STG_unique_suffix();
  execute("ring "+rname+"="+charstr(oldring)+",(x0,x1,x2,x3,x4),dp;");
  execute("def STG_CREATED_RING="+rname+";");
  def R=STG_CREATED_RING;
  kill STG_CREATED_RING;
  setring R;
  poly Q=STG_random_homogeneous(2,bound);
  poly C=STG_random_homogeneous(3,bound);
  ideal I=Q,C;
  list Out=R,I,"K3","generic smooth complete intersection of a quadric and a cubic in P^4";
  execute("keepring "+rname+";");
  return(Out);
}

proc STG_abelian_product(list #)
"USAGE:   STG_abelian_product([lambda,mu]);
RETURN:  list [R,I,\"abelian\",description], where I defines E_lambda x E_mu
         in the Segre P^2 x P^2 subset P^8.
MATHEMATICS:
         A smooth plane cubic is an elliptic curve.  The product of two elliptic
         curves is an abelian surface.  The Segre equations impose rank one on a
         3x3 coordinate matrix; the column equations cut the first cubic and the
         row equations cut the second cubic.
EXAMPLE: ring r=31991,(dummy),dp; list A=STG_abelian_product(2,5); setring A[1]; A[2];
"
{
  string lambdaString="2";
  string muString="5";
  if(size(#)>0) { lambdaString=string(#[1]); }
  if(size(#)>1) { muString=string(#[2]); }
  def oldring=basering;
  string rname="STG_abelian_R"+STG_unique_suffix();
  execute("ring "+rname+"="+charstr(oldring)+",(z00,z01,z02,z10,z11,z12,z20,z21,z22),dp;");
  execute("def STG_CREATED_RING="+rname+";");
  def R=STG_CREATED_RING;
  kill STG_CREATED_RING;
  setring R;
  execute("number lambdaCoeff="+lambdaString+";");
  execute("number muCoeff="+muString+";");
  matrix Z[3][3]=z00,z01,z02,z10,z11,z12,z20,z21,z22;
  ideal I=STG_segre_2x2_minors(Z);
  int j;
  for(j=1;j<=3;j=j+1)
  {
    I[size(I)+1]=STG_hesse(Z[1,j],Z[2,j],Z[3,j],lambdaCoeff);
  }
  int i;
  for(i=1;i<=3;i=i+1)
  {
    I[size(I)+1]=STG_hesse(Z[i,1],Z[i,2],Z[i,3],muCoeff);
  }
  list Out=R,I,"abelian","generic product abelian surface E_lambda x E_mu in the Segre embedding P^2 x P^2 -> P^8; choose lambda^3 and mu^3 different from 1";
  execute("keepring "+rname+";");
  return(Out);
}

proc STG_elliptic_ruled(list #)
"USAGE:   STG_elliptic_ruled([lambda]);
RETURN:  list [R,I,\"ruled\",description], defining E_lambda x P^1 in the
         Segre P^2 x P^1 subset P^5.
MATHEMATICS:
         The product E x P^1 is a geometrically ruled surface over an elliptic
         curve.  It has Kodaira dimension -infinity and irregularity 1.  The
         Segre rank-one equations give P^2 x P^1, and the cubic equation in
         every column cuts the elliptic curve factor.
EXAMPLE: ring r=31991,(dummy),dp; list S=STG_elliptic_ruled(2); setring S[1]; S[2];
"
{
  string lambdaString="2";
  if(size(#)>0) { lambdaString=string(#[1]); }
  def oldring=basering;
  string rname="STG_elliptic_ruled_R"+STG_unique_suffix();
  execute("ring "+rname+"="+charstr(oldring)+",(z00,z01,z10,z11,z20,z21),dp;");
  execute("def STG_CREATED_RING="+rname+";");
  def R=STG_CREATED_RING;
  kill STG_CREATED_RING;
  setring R;
  execute("number lambdaCoeff="+lambdaString+";");
  matrix Z[3][2]=z00,z01,z10,z11,z20,z21;
  ideal I=STG_segre_2x2_minors(Z);
  I[size(I)+1]=STG_hesse(Z[1,1],Z[2,1],Z[3,1],lambdaCoeff);
  I[size(I)+1]=STG_hesse(Z[1,2],Z[2,2],Z[3,2],lambdaCoeff);
  list Out=R,I,"ruled","generic ruled surface E x P^1 over a smooth Hesse cubic E; same Kodaira type as elliptic scroll examples, not the special quintic P^4 embedding";
  execute("keepring "+rname+";");
  return(Out);
}

proc STG_elliptic_surface(list #)
"USAGE:   STG_elliptic_surface([lambda,bound]);
RETURN:  list [R,I,\"elliptic\",description], defining E_lambda x C where C is
         a random smooth plane quartic, inside the Segre P^2 x P^2 subset P^8.
MATHEMATICS:
         Projection to the genus-3 curve C gives an isotrivial elliptic fibration
         with fibre E.  Since kappa(E)=0 and kappa(C)=1, the product surface has
         Kodaira dimension 1.  Smoothness of the quartic is open.
EXAMPLE: ring r=31991,(dummy),dp; list E=STG_elliptic_surface(2,10); setring E[1]; E[2];
"
{
  string lambdaString="2";
  int bound=20;
  if(size(#)>0) { lambdaString=string(#[1]); }
  if(size(#)>1) { bound=#[2]; }
  def oldring=basering;
  string rname="STG_elliptic_surface_R"+STG_unique_suffix();
  execute("ring "+rname+"="+charstr(oldring)+",(z00,z01,z02,z10,z11,z12,z20,z21,z22),dp;");
  execute("def STG_CREATED_RING="+rname+";");
  def R=STG_CREATED_RING;
  kill STG_CREATED_RING;
  setring R;
  execute("number lambdaCoeff="+lambdaString+";");
  matrix Z[3][3]=z00,z01,z02,z10,z11,z12,z20,z21,z22;
  ideal I=STG_segre_2x2_minors(Z);
  int j;
  for(j=1;j<=3;j=j+1)
  {
    I[size(I)+1]=STG_hesse(Z[1,j],Z[2,j],Z[3,j],lambdaCoeff);
  }
  number a=STG_coeff(bound);
  number b=STG_coeff(bound);
  number c=STG_coeff(bound);
  number d=STG_coeff(bound);
  poly Q1=STG_quartic3_special(Z[1,1],Z[1,2],Z[1,3],a,b,c,d);
  poly Q2=STG_quartic3_special(Z[2,1],Z[2,2],Z[2,3],a,b,c,d);
  poly Q3=STG_quartic3_special(Z[3,1],Z[3,2],Z[3,3],a,b,c,d);
  I[size(I)+1]=Q1;
  I[size(I)+1]=Q2;
  I[size(I)+1]=Q3;
  list Out=R,I,"elliptic","generic isotrivial properly elliptic surface E x C, with E a Hesse cubic and C a random smooth plane quartic";
  execute("keepring "+rname+";");
  return(Out);
}

proc STG_Enriques_cover(list #)
"USAGE:   STG_Enriques_cover([bound]);
RETURN:  list [R,I,\"Enriques-cover\",involution,description].  I is a K3 cover
         in P^5 cut out by three invariant quadrics.
MATHEMATICS:
         Let P^5 have coordinates x0,x1,x2,y0,y1,y2 and let iota fix the x's
         and negate the y's.  Three general invariant quadrics q_i(x)+r_i(y)
         cut out a smooth K3 complete intersection.  For a non-empty open set of
         such triples, the cover avoids the two fixed P^2's of iota, so iota is
         fixed-point-free on the K3 surface.  The quotient is then an Enriques
         surface in characteristic not 2.
EXAMPLE: ring r=31991,(dummy),dp; list C=STG_Enriques_cover(); setring C[1]; C[2];
"
{
  int bound=STG_default_bound(#);
  def oldring=basering;
  string rname="STG_Enriques_cover_R"+STG_unique_suffix();
  execute("ring "+rname+"="+charstr(oldring)+",(x0,x1,x2,y0,y1,y2),dp;");
  execute("def STG_CREATED_RING="+rname+";");
  def R=STG_CREATED_RING;
  kill STG_CREATED_RING;
  setring R;
  poly q1=STG_form3(x0,x1,x2,2,bound)+STG_form3(y0,y1,y2,2,bound);
  poly q2=STG_form3(x0,x1,x2,2,bound)+STG_form3(y0,y1,y2,2,bound);
  poly q3=STG_form3(x0,x1,x2,2,bound)+STG_form3(y0,y1,y2,2,bound);
  ideal I=q1,q2,q3;
  string inv="iota: (x0,x1,x2,y0,y1,y2) -> (x0,x1,x2,-y0,-y1,-y2)";
  list Out=R,I,"Enriques-cover",inv,"quotient of this K3 cover by the displayed fixed-point-free involution is a generic Enriques-type surface, in characteristic not 2";
  execute("keepring "+rname+";");
  return(Out);
}

proc STG_Enriques_quotient_image(list #)
"USAGE:   STG_Enriques_quotient_image([bound]);
RETURN:  list [Rbig,J,\"Enriques\",description].  J is an elimination ideal for
         an invariant-quadratic projective model of the quotient.
MATHEMATICS:
         This refines STG_Enriques_cover.  The quotient by y -> -y is mapped by
         the invariant quadrics x_i x_j and y_i y_j.  Eliminating the K3-cover
         variables gives the ideal of the image of the quotient under this
         invariant linear system.  The computation is slower than returning the
         cover data but is a genuine projective quotient model.
EXAMPLE: ring r=31991,(dummy),dp; list E=STG_Enriques_quotient_image(5); setring E[1]; E[2];
"
{
  int bound=STG_default_bound(#);
  def oldring=basering;
  string rname="STG_Enriques_quotient_R"+STG_unique_suffix();
  execute("ring "+rname+"="+charstr(oldring)+",(x0,x1,x2,y0,y1,y2,u1,u2,u3,u4,u5,u6,u7,u8,u9,u10,u11,u12),(dp(6),dp(12));");
  execute("def STG_CREATED_RING="+rname+";");
  def Rbig=STG_CREATED_RING;
  kill STG_CREATED_RING;
  setring Rbig;
  poly q1=STG_form3(x0,x1,x2,2,bound)+STG_form3(y0,y1,y2,2,bound);
  poly q2=STG_form3(x0,x1,x2,2,bound)+STG_form3(y0,y1,y2,2,bound);
  poly q3=STG_form3(x0,x1,x2,2,bound)+STG_form3(y0,y1,y2,2,bound);
  ideal I=q1,q2,q3;
  ideal F;
  F[1]=x0^2; F[2]=x0*x1; F[3]=x0*x2; F[4]=x1^2; F[5]=x1*x2; F[6]=x2^2;
  F[7]=y0^2; F[8]=y0*y1; F[9]=y0*y2; F[10]=y1^2; F[11]=y1*y2; F[12]=y2^2;
  ideal E=I;
  int i;
  for(i=1;i<=12;i=i+1)
  {
    E[size(E)+1]=var(6+i)-F[i];
  }
  poly src=x0*x1*x2*y0*y1*y2;
  ideal J=eliminate(E,src);
  string tname="STG_Enriques_quotient_target_R"+STG_unique_suffix();
  execute("ring "+tname+"="+charstr(oldring)+",(u1,u2,u3,u4,u5,u6,u7,u8,u9,u10,u11,u12),dp;");
  execute("def STG_CREATED_RING="+tname+";");
  def Rt=STG_CREATED_RING;
  kill STG_CREATED_RING;
  setring Rt;
  ideal Jt=imap(Rbig,J);
  list Out=Rt,Jt,"Enriques","projective quotient image of a generic Enriques K3 cover by invariant quadrics; characteristic not 2";
  execute("keepring "+tname+";");
  return(Out);
}

proc STG_bielliptic_cover_data(list #)
"USAGE:   STG_bielliptic_cover_data([lambda,mu]);
RETURN:  list [R,I,\"bielliptic-cover\",action,description], where I defines
         E_lambda x F_mu in P^8 and action describes a free cyclic quotient.
MATHEMATICS:
         A bielliptic, also called hyperelliptic in the surface-classification
         literature, surface is a free finite quotient of a product of elliptic
         curves.  In the Hesse pencil, the cyclic permutation of coordinates is
         a translation by a 3-torsion point on a smooth member, hence has no
         fixed points.  Combining this free translation on the first factor with
         an order-3 automorphism of the second factor gives a free diagonal
         action on the product.  The quotient is bielliptic in characteristic
         not 3; for explicit invariant equations one should work over a field
         containing a primitive cube root of unity.
EXAMPLE: ring r=31991,(dummy),dp; list B=STG_bielliptic_cover_data(2,5); setring B[1]; B[2];
"
{
  string lambdaString="2";
  string muString="5";
  if(size(#)>0) { lambdaString=string(#[1]); }
  if(size(#)>1) { muString=string(#[2]); }
  def oldring=basering;
  string rname="STG_bielliptic_cover_R"+STG_unique_suffix();
  execute("ring "+rname+"="+charstr(oldring)+",(z00,z01,z02,z10,z11,z12,z20,z21,z22),dp;");
  execute("def STG_CREATED_RING="+rname+";");
  def R=STG_CREATED_RING;
  kill STG_CREATED_RING;
  setring R;
  execute("number lambdaCoeff="+lambdaString+";");
  execute("number muCoeff="+muString+";");
  matrix Z[3][3]=z00,z01,z02,z10,z11,z12,z20,z21,z22;
  ideal I=STG_segre_2x2_minors(Z);
  int j;
  for(j=1;j<=3;j=j+1)
  {
    I[size(I)+1]=STG_hesse(Z[1,j],Z[2,j],Z[3,j],lambdaCoeff);
  }
  int i;
  for(i=1;i<=3;i=i+1)
  {
    I[size(I)+1]=STG_hesse(Z[i,1],Z[i,2],Z[i,3],muCoeff);
  }
  string action="g: first Hesse factor (x0,x1,x2)->(x1,x2,x0); second factor an order-3 automorphism with quotient P^1, e.g. diagonal (u0,u1,u2)->(u0,omega*u1,omega^2*u2) over a field with omega^2+omega+1=0";
  list Out=R,I,"bielliptic-cover",action,"the quotient of this product of elliptic curves by the displayed free cyclic action is a generic bielliptic/hyperelliptic-type surface; characteristic not 3";
  execute("keepring "+rname+";");
  return(Out);
}

proc STG_rational_surface(list #)
"USAGE:   STG_rational_surface([bound]);
RETURN:  list [R,I,\"rational\",description].
MATHEMATICS:
         This is the default generic rational representative: a cubic scroll in
         P^4.  Many rational examples in special catalogues are blow-ups of P^2
         embedded by special linear systems; the minimal Kodaira type is already
         represented by this generic scroll family.
EXAMPLE: ring r=31991,(dummy),dp; list R=STG_rational_surface(); setring R[1]; R[2];
"
{
  int bound=STG_default_bound(#);
  def oldring=basering;
  string rname="STG_rational_R"+STG_unique_suffix();
  execute("ring "+rname+"="+charstr(oldring)+",(x0,x1,x2,x3,x4),dp;");
  execute("def STG_CREATED_RING="+rname+";");
  def R=STG_CREATED_RING;
  kill STG_CREATED_RING;
  setring R;
  matrix M[2][3];
  int i;
  int j;
  for(i=1;i<=2;i=i+1)
  {
    for(j=1;j<=3;j=j+1)
    {
      M[i,j]=STG_random_homogeneous(1,bound);
    }
  }
  ideal I=minor(M,2);
  list Out=R,I,"rational","generic rational representative: a cubic rational normal scroll in P^4";
  execute("keepring "+rname+";");
  return(Out);
}

proc STG_genericSurface(string surfaceType, list #)
"USAGE:   STG_genericSurface(type[,parameters]);
RETURN:  no return; use a direct constructor instead.
MATHEMATICS:
         Singular procedures which create and return rings have to return from
         the constructor itself.  A dispatcher that calls such a constructor
         cannot safely return the constructed [ring,ideal,...] list.  Use
         STG_K3, STG_cubic_scroll, STG_abelian_product, and the other direct
         constructors instead.
EXAMPLE: STGsurfaceTypes();
"
{
  ERROR("STG_genericSurface cannot safely dispatch ring-returning constructors; use the direct STG_* constructor for the requested type");
}

///////////////////////////////////////////////////////////////////////////////
// Catalogue wrappers.  They preserve surface type, not necessarily embedded
// degree and sectional genus.  Direct constructors preserve the standard simple
// model: cubic scroll, projected Veronese, K3 (2,3), product models, and quotient
// data.  The high-degree P^4 families require specialized liaison/syzygy
// parameter spaces and are intentionally represented here by generic type models.
///////////////////////////////////////////////////////////////////////////////

proc STG_catalogueNames()
"USAGE:   STG_catalogueNames();
RETURN:  list of supported catalogue labels.
MATHEMATICS:
         The labels are grouped by surface type.  Use STG_catalogueSurface(name)
         to obtain a generic representative of the corresponding type.
EXAMPLE: list N=STG_catalogueNames(); N[1];
"
{
  list L="cubic_scroll","veronese","castelnuovo","bordiga","rational_d7_pi4","rational_d8_pi5","rational_d8_pi6","rational_d9_pi6","rational_d9_pi7","rational_d10_pi8","rational_d10_pi9_quart_1","rational_d10_pi9_quart_2","rational_d11_pi11_ss_0","rational_d11_pi11_ss_1","rational_d11_pi11_ss_inf","quintic_elliptic_scroll","enriques_d9_pi6","enriques_d10_pi8","enriques_d11_pi10","enriques_d13_pi16","enriques_d13_pi16_two","k3_d7_pi5","k3_d8_pi6","k3_d9_pi8","k3_d10_pi9_quart_1","k3_d10_pi9_quart_2","k3_d11_pi11_ss_0","k3_d11_pi11_ss_1","k3_d11_pi11_ss_2","k3_d11_pi11_ss_3","k3_d11_pi12","k3_d12_pi14","k3_d13_pi16","k3_d14_pi19","bielliptic_d10_pi6","bielliptic_d15_pi21","abelian_d10_pi6","abelian_d15_pi21_quintic_3","abelian_d15_pi21_quintic_1","elliptic_d7_pi6","elliptic_d8_pi7","elliptic_d9_pi7","elliptic_d10_pi9","elliptic_d10_pi10","elliptic_d11_pi12","elliptic_d12_pi13","elliptic_d12_pi14_ss_0","elliptic_d12_pi14_ss_inf";
  return(L);
}

proc STG_catalogueType(string name)
"USAGE:   STG_catalogueType(name);
RETURN:  one of rational, elliptic_ruled, Enriques, K3, bielliptic, abelian,
         elliptic, or unknown.
MATHEMATICS:
         This only records the surface type associated with a label; it is not
         an embedded Hilbert-polynomial classifier.
EXAMPLE: STG_catalogueType(\"k3_d12_pi14\");
"
{
  if(name=="cubic_scroll") { return("rational_scroll"); }
  if(name=="veronese") { return("projected_veronese"); }
  if(name=="castelnuovo") { return("rational"); }
  if(name=="bordiga") { return("rational"); }
  if(name=="rational_d7_pi4") { return("rational"); }
  if(name=="rational_d8_pi5") { return("rational"); }
  if(name=="rational_d8_pi6") { return("rational"); }
  if(name=="rational_d9_pi6") { return("rational"); }
  if(name=="rational_d9_pi7") { return("rational"); }
  if(name=="rational_d10_pi8") { return("rational"); }
  if(name=="rational_d10_pi9_quart_1") { return("rational"); }
  if(name=="rational_d10_pi9_quart_2") { return("rational"); }
  if(name=="rational_d11_pi11_ss_0") { return("rational"); }
  if(name=="rational_d11_pi11_ss_1") { return("rational"); }
  if(name=="rational_d11_pi11_ss_inf") { return("rational"); }
  if(name=="quintic_elliptic_scroll") { return("elliptic_ruled"); }
  if(name=="enriques_d9_pi6") { return("Enriques"); }
  if(name=="enriques_d10_pi8") { return("Enriques"); }
  if(name=="enriques_d11_pi10") { return("Enriques"); }
  if(name=="enriques_d13_pi16") { return("Enriques"); }
  if(name=="enriques_d13_pi16_two") { return("Enriques"); }
  if(name=="k3_d7_pi5") { return("K3"); }
  if(name=="k3_d8_pi6") { return("K3"); }
  if(name=="k3_d9_pi8") { return("K3"); }
  if(name=="k3_d10_pi9_quart_1") { return("K3"); }
  if(name=="k3_d10_pi9_quart_2") { return("K3"); }
  if(name=="k3_d11_pi11_ss_0") { return("K3"); }
  if(name=="k3_d11_pi11_ss_1") { return("K3"); }
  if(name=="k3_d11_pi11_ss_2") { return("K3"); }
  if(name=="k3_d11_pi11_ss_3") { return("K3"); }
  if(name=="k3_d11_pi12") { return("K3"); }
  if(name=="k3_d12_pi14") { return("K3"); }
  if(name=="k3_d13_pi16") { return("K3"); }
  if(name=="k3_d14_pi19") { return("K3"); }
  if(name=="bielliptic_d10_pi6") { return("bielliptic"); }
  if(name=="bielliptic_d15_pi21") { return("bielliptic"); }
  if(name=="abelian_d10_pi6") { return("abelian"); }
  if(name=="abelian_d15_pi21_quintic_3") { return("abelian"); }
  if(name=="abelian_d15_pi21_quintic_1") { return("abelian"); }
  if(name=="elliptic_d7_pi6") { return("elliptic"); }
  if(name=="elliptic_d8_pi7") { return("elliptic"); }
  if(name=="elliptic_d9_pi7") { return("elliptic"); }
  if(name=="elliptic_d10_pi9") { return("elliptic"); }
  if(name=="elliptic_d10_pi10") { return("elliptic"); }
  if(name=="elliptic_d11_pi12") { return("elliptic"); }
  if(name=="elliptic_d12_pi13") { return("elliptic"); }
  if(name=="elliptic_d12_pi14_ss_0") { return("elliptic"); }
  if(name=="elliptic_d12_pi14_ss_inf") { return("elliptic"); }
  return("unknown");
}

proc STG_catalogueSurface(string name, list #)
"USAGE:   STG_catalogueSurface(name[,parameters]);
RETURN:  no return; use STG_catalogueType and a direct constructor instead.
MATHEMATICS:
         This library keeps catalogue labels as metadata.  Because Singular
         ring-returning constructors cannot be wrapped safely, choose the direct
         constructor corresponding to STG_catalogueType(name).
EXAMPLE: STG_catalogueType(\"abelian_d10_pi6\");
"
{
  string t=STG_catalogueType(name);
  if(t=="unknown") { ERROR("STG_catalogueSurface: unknown label"); }
  ERROR("STG_catalogueSurface cannot safely dispatch ring-returning constructors; call STG_catalogueType(name) and then a direct STG_* constructor");
}

// Short aliases for the catalogue labels.  Each alias has its own doc string,
// so help output remains meaningful even when the function is not the preferred
// public entry point.

proc STG_veronese(list #)
"USAGE: STG_veronese([bound]); RETURN: generic projected Veronese rational surface. MATHEMATICS: image of P^2 by a general subsystem of conics. EXAMPLE: ring r=31991,(dummy),dp; list S=STG_veronese();
"
{ return(STG_projected_veronese(#)); }

proc STG_castelnuovo(list #)
"USAGE: STG_castelnuovo([bound]); RETURN: generic rational surface model. MATHEMATICS: returns a generic rational representative of the Castelnuovo-type rational class; exact P^4 Hilbert data require a specialized plane blow-up parameter space. EXAMPLE: ring r=31991,(dummy),dp; list S=STG_castelnuovo();
"
{ return(STG_rational_surface(#)); }

proc STG_bordiga(list #)
"USAGE: STG_bordiga([bound]); RETURN: generic rational surface model. MATHEMATICS: returns a generic rational representative of the Bordiga-type rational class; exact Bordiga embeddings are quartic plane blow-up models through ten points. EXAMPLE: ring r=31991,(dummy),dp; list S=STG_bordiga();
"
{ return(STG_rational_surface(#)); }

proc STG_quintic_elliptic_scroll(list #)
"USAGE: STG_quintic_elliptic_scroll([lambda]); RETURN: generic ruled surface over an elliptic curve. MATHEMATICS: E x P^1 has the same ruled-over-elliptic Kodaira type; the special quintic P^4 scroll embedding is not imposed. EXAMPLE: ring r=31991,(dummy),dp; list S=STG_quintic_elliptic_scroll();
"
{ return(STG_elliptic_ruled(#)); }

// Rational labels
proc STG_rational_d7_pi4(list #) "USAGE: STG_rational_d7_pi4([bound]); RETURN: generic rational representative. MATHEMATICS: same rational surface type; special P^4 invariants not imposed. EXAMPLE: ring r=31991,(dummy),dp; list S=STG_rational_d7_pi4();" { return(STG_rational_surface(#)); }
proc STG_rational_d8_pi5(list #) "USAGE: STG_rational_d8_pi5([bound]); RETURN: generic rational representative. MATHEMATICS: same rational surface type; special P^4 invariants not imposed. EXAMPLE: ring r=31991,(dummy),dp; list S=STG_rational_d8_pi5();" { return(STG_rational_surface(#)); }
proc STG_rational_d8_pi6(list #) "USAGE: STG_rational_d8_pi6([bound]); RETURN: generic rational representative. MATHEMATICS: same rational surface type; special P^4 invariants not imposed. EXAMPLE: ring r=31991,(dummy),dp; list S=STG_rational_d8_pi6();" { return(STG_rational_surface(#)); }
proc STG_rational_d9_pi6(list #) "USAGE: STG_rational_d9_pi6([bound]); RETURN: generic rational representative. MATHEMATICS: same rational surface type; special P^4 invariants not imposed. EXAMPLE: ring r=31991,(dummy),dp; list S=STG_rational_d9_pi6();" { return(STG_rational_surface(#)); }
proc STG_rational_d9_pi7(list #) "USAGE: STG_rational_d9_pi7([bound]); RETURN: generic rational representative. MATHEMATICS: same rational surface type; special P^4 invariants not imposed. EXAMPLE: ring r=31991,(dummy),dp; list S=STG_rational_d9_pi7();" { return(STG_rational_surface(#)); }
proc STG_rational_d10_pi8(list #) "USAGE: STG_rational_d10_pi8([bound]); RETURN: generic rational representative. MATHEMATICS: same rational surface type; special P^4 invariants not imposed. EXAMPLE: ring r=31991,(dummy),dp; list S=STG_rational_d10_pi8();" { return(STG_rational_surface(#)); }
proc STG_rational_d10_pi9_quart_1(list #) "USAGE: STG_rational_d10_pi9_quart_1([bound]); RETURN: generic rational representative. MATHEMATICS: same rational surface type; quartic-containment condition not imposed. EXAMPLE: ring r=31991,(dummy),dp; list S=STG_rational_d10_pi9_quart_1();" { return(STG_rational_surface(#)); }
proc STG_rational_d10_pi9_quart_2(list #) "USAGE: STG_rational_d10_pi9_quart_2([bound]); RETURN: generic rational representative. MATHEMATICS: same rational surface type; quartic-pencil condition not imposed. EXAMPLE: ring r=31991,(dummy),dp; list S=STG_rational_d10_pi9_quart_2();" { return(STG_rational_surface(#)); }
proc STG_rational_d11_pi11_ss_0(list #) "USAGE: STG_rational_d11_pi11_ss_0([bound]); RETURN: generic rational representative. MATHEMATICS: same rational surface type; secant condition not imposed. EXAMPLE: ring r=31991,(dummy),dp; list S=STG_rational_d11_pi11_ss_0();" { return(STG_rational_surface(#)); }
proc STG_rational_d11_pi11_ss_1(list #) "USAGE: STG_rational_d11_pi11_ss_1([bound]); RETURN: generic rational representative. MATHEMATICS: same rational surface type; secant condition not imposed. EXAMPLE: ring r=31991,(dummy),dp; list S=STG_rational_d11_pi11_ss_1();" { return(STG_rational_surface(#)); }
proc STG_rational_d11_pi11_ss_inf(list #) "USAGE: STG_rational_d11_pi11_ss_inf([bound]); RETURN: generic rational representative. MATHEMATICS: same rational surface type; secant condition not imposed. EXAMPLE: ring r=31991,(dummy),dp; list S=STG_rational_d11_pi11_ss_inf();" { return(STG_rational_surface(#)); }

// Enriques labels
proc STG_enriques_d9_pi6(list #) "USAGE: STG_enriques_d9_pi6([bound]); RETURN: generic Enriques quotient-cover data. MATHEMATICS: K3 complete intersection with fixed-point-free involution; quotient is Enriques in char not 2. EXAMPLE: ring r=31991,(dummy),dp; list S=STG_enriques_d9_pi6();" { return(STG_Enriques_cover(#)); }
proc STG_enriques_d10_pi8(list #) "USAGE: STG_enriques_d10_pi8([bound]); RETURN: generic Enriques quotient-cover data. MATHEMATICS: K3 complete intersection with fixed-point-free involution; quotient is Enriques in char not 2. EXAMPLE: ring r=31991,(dummy),dp; list S=STG_enriques_d10_pi8();" { return(STG_Enriques_cover(#)); }
proc STG_enriques_d11_pi10(list #) "USAGE: STG_enriques_d11_pi10([bound]); RETURN: generic Enriques quotient-cover data. MATHEMATICS: K3 complete intersection with fixed-point-free involution; quotient is Enriques in char not 2. EXAMPLE: ring r=31991,(dummy),dp; list S=STG_enriques_d11_pi10();" { return(STG_Enriques_cover(#)); }
proc STG_enriques_d13_pi16(list #) "USAGE: STG_enriques_d13_pi16([bound]); RETURN: generic Enriques quotient-cover data. MATHEMATICS: K3 complete intersection with fixed-point-free involution; quotient is Enriques in char not 2. EXAMPLE: ring r=31991,(dummy),dp; list S=STG_enriques_d13_pi16();" { return(STG_Enriques_cover(#)); }
proc STG_enriques_d13_pi16_two(list #) "USAGE: STG_enriques_d13_pi16_two([bound]); RETURN: generic Enriques quotient-cover data. MATHEMATICS: K3 complete intersection with fixed-point-free involution; quotient is Enriques in char not 2. EXAMPLE: ring r=31991,(dummy),dp; list S=STG_enriques_d13_pi16_two();" { return(STG_Enriques_cover(#)); }

// K3 labels
proc STG_k3_d7_pi5(list #) "USAGE: STG_k3_d7_pi5([bound]); RETURN: generic K3 surface. MATHEMATICS: smooth (2,3) complete intersection in P^4; same K3 type. EXAMPLE: ring r=31991,(dummy),dp; list S=STG_k3_d7_pi5();" { return(STG_K3(#)); }
