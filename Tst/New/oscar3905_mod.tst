LIB "tst.lib"; tst_init();
LIB"modprimdec.lib";

// primdec for principal ideal

ring r=(0,a),(x,y,t),dp;
minpoly=a6+a5+a4+a3+a2+a+1;
poly f= -x^3 + (127961567541885/2*a^5 + 230578777287775/2*a^4 + 230578777287775/2*a^3 + 127961567541885/2*a^2 - 455586040332045/16)*x + y^2 + (3242437110294043228*a^5 + 5842669785012830924*a^4 + 5842669785012830924*a^3 + 3242437110294043228*a^2 - 1443020268154487519)*t^7 + 9351999235365594180359/8*a^5 + 16851720327423257592547/8*a^4 + 16851720327423257592547/8*a^3 + 9351999235365594180359/8*a^2 - 16648124833698322506703/32;
factorize(f);
modPrimdecGTZ(ideal(f));

tst_status(1);$


